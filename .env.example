# Copy this file to .env and fill in real values. .env is gitignored.

# RTSP camera credentials (added to every camera URL that doesn't carry its own)
RTSP_USERNAME=admin
RTSP_PASSWORD=changeme

# Scheme used when a camera entry below doesn't include one (rtsps or rtsp)
RTSP_SCHEME=rtsps

# Cameras usually have self-signed certs; set to 1 only if yours are trusted
RTSP_TLS_VERIFY=0

# One entry per camera: RTSP_CAMERA_<NAME>=host:port/path  (or a full rtsps:// URL)
RTSP_CAMERA_FRONT_DOOR=192.168.1.50:7441/stream1

# Optional: ffmpeg.exe or its bin folder, needed when running as an NSSM service
# FFMPEG_LOCATION=C:\path\to\ffmpeg\bin
